# Frontend
VITE_OTP_API_URL=http://localhost:5000

# OTP backend server
OTP_SERVER_PORT=5000

# Email SMTP config (required for real email delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Defynix Risk <no-reply@example.com>"

# Twilio config (required for real SMS/WhatsApp delivery)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=+1234567890
